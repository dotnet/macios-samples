<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <ApplicationId>org.dotnet.samples.PurchaseSample</ApplicationId>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Binding/StoreBridge.csproj" />
    <ProjectReference Include="../ReceiptValidation/ReceiptValidation.csproj" />
    <BundleResource Include="../ReceiptValidation/AppleIncRootCertificate.cer" Link="AppleIncRootCertificate.cer" />
  </ItemGroup>
</Project>
