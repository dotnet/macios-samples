<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>27.0</SupportedOSPlatformVersion>
    <IsAppExtension>true</IsAppExtension>
    <ApplicationId>com.example.BackgroundAssets.downloader</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <CustomEntitlements Include="com.apple.security.application-groups" Type="StringArray" Value="group.com.example.BackgroundAssets" />
  </ItemGroup>
</Project>
