<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>27.0</SupportedOSPlatformVersion>
    <ApplicationId>com.example.BackgroundAssets</ApplicationId>
    <ApplicationTitle>Background Assets</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DownloaderExtension/DownloaderExtension.csproj">
      <IsAppExtension>true</IsAppExtension>
    </ProjectReference>
    <CustomEntitlements Include="com.apple.security.application-groups" Type="StringArray" Value="group.com.example.BackgroundAssets" />
  </ItemGroup>
</Project>
